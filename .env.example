# ===========================================================================
# Continuity Guardian — Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT commit .env or service account JSON files to version control.
# ===========================================================================

# Google Gemini API Key (Required for LLM reasoning and Script Doctor)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Parallel AI MCP Search API Key (Required for real-world web fact verification)
# Obtain from: https://parallel.ai
PARALLEL_API_KEY=your_parallel_api_key_here

# Google Cloud / Firebase Project ID
FIREBASE_PROJECT_ID=continuity-guardian-e4064

# Local path to Firebase Admin SDK service account key JSON file
FIREBASE_CREDENTIALS_PATH=data/continuity-guardian-e4064-firebase-adminsdk-fbsvc-92cf7f3c1e.json

# (Alternative for Vercel / Cloud Run) Raw JSON string of service account key
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
